# ==============================================================================
# FISH N FRESH HUB - MULTI-CLIENT WHITE-LABEL ENVIRONMENT CONFIGURATION
# ==============================================================================
# To deploy for a new client (or change Supabase backend):
# 1. Copy this file to `.env` (or add to your Vercel / Cloudflare Pages project settings).
# 2. Fill in the client's custom Supabase URL and Publishable Key.
# 3. Whenever you run `git push origin main`, all client apps receive updates automatically!
# ==============================================================================

# 1. Client Store Branding
VITE_STORE_NAME="Fish N Fresh Hub"
VITE_DEFAULT_VERTICAL="seafood" # Options: 'seafood' | 'chicken_meat' | 'all_meat'

# 2. Client Independent Supabase Account
# (Get these from Client's Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-client-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
VITE_SUPABASE_PROJECT_ID="your-client-project-id"

# 3. Store Contact & Doorstep Dynamic UPI
VITE_SUPPORT_PHONE="9843061919"
VITE_UPI_ID="9843061919@upi"
VITE_UPI_NAME="Fish N Fresh Hub"

# 4. Optional Firebase Cloud Messaging (Push Notifications)
VITE_FCM_PROJECT_ID="fish-n-fresh-hub"
